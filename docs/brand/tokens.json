{
  "project": "Loco Monitor",
  "referenceVersion": 2,
  "issue": "https://github.com/ojcezarferreira/loco_monitor/issues/1",
  "description": "Visual identity agreed with the maintainer. Typography ranges preserve the proposed sizes; final sizing belongs to component implementation.",
  "css": {
    "scopeAttribute": "data-loco-monitor-theme",
    "prefix": "--lm-",
    "colorFormat": "sRGB hex"
  },
  "themes": {
    "light": {
      "colorScheme": "light",
      "colors": {
        "background": "#F7F7F8",
        "surface": "#FFFFFF",
        "surface-raised": "#F0F0F2",
        "border-subtle": "#DDDEE3",
        "border-control": "#818792",
        "text-primary": "#18191C",
        "text-secondary": "#626773",
        "primary": "#B54728",
        "primary-hover": "#973B21",
        "primary-foreground": "#FFFFFF",
        "primary-subtle": "#FBEDE7",
        "focus-ring": "#B54728"
      },
      "states": {
        "running": {
          "foreground": "#1D5EC9",
          "background": "#EDF4FF"
        },
        "success": {
          "foreground": "#18794E",
          "background": "#EAF7EF"
        },
        "warning": {
          "foreground": "#8C5B0A",
          "background": "#FFF6D9"
        },
        "error": {
          "foreground": "#C0343D",
          "background": "#FFF0F1"
        },
        "scheduled": {
          "foreground": "#6E49BF",
          "background": "#F3EEFF"
        },
        "neutral": {
          "foreground": "#626773",
          "background": "#F0F0F2"
        }
      }
    },
    "dark": {
      "colorScheme": "dark",
      "colors": {
        "background": "#111214",
        "surface": "#1A1C20",
        "surface-raised": "#24272C",
        "border-subtle": "#353940",
        "border-control": "#707885",
        "text-primary": "#F3F4F6",
        "text-secondary": "#A7ADB7",
        "primary": "#F08A65",
        "primary-hover": "#F5A181",
        "primary-foreground": "#21130D",
        "primary-subtle": "#38251E",
        "focus-ring": "#F08A65"
      },
      "states": {
        "running": {
          "foreground": "#81AFFF",
          "background": "#1A2940"
        },
        "success": {
          "foreground": "#65D6A2",
          "background": "#172E25"
        },
        "warning": {
          "foreground": "#E7C46A",
          "background": "#332B18"
        },
        "error": {
          "foreground": "#FF8B94",
          "background": "#391F25"
        },
        "scheduled": {
          "foreground": "#BAA0F5",
          "background": "#2B2340"
        },
        "neutral": {
          "foreground": "#A7ADB7",
          "background": "#24272C"
        }
      }
    }
  },
  "stateSemantics": {
    "running": "Running or operational information.",
    "success": "Successful completion or healthy condition.",
    "warning": "Warning or retry after failure.",
    "error": "Failure or error.",
    "scheduled": "Scheduled.",
    "neutral": "Queued or intentionally paused.",
    "offline": "Context dependent: intentional stops can be neutral; unexpected communication loss requires warning or error according to product severity."
  },
  "typography": {
    "families": {
      "sans": {
        "name": "IBM Plex Sans",
        "cssStack": [
          "IBM Plex Sans",
          "system-ui",
          "sans-serif"
        ],
        "weights": [
          400,
          500,
          600
        ]
      },
      "mono": {
        "name": "IBM Plex Mono",
        "cssStack": [
          "IBM Plex Mono",
          "ui-monospace",
          "monospace"
        ],
        "weights": [
          400,
          500
        ]
      }
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "roles": {
      "page-title": {
        "family": "sans",
        "weights": [
          600
        ],
        "sizePx": {
          "min": 24,
          "max": 28
        }
      },
      "section-title": {
        "family": "sans",
        "weights": [
          500,
          600
        ],
        "sizePx": {
          "min": 16,
          "max": 18
        }
      },
      "body": {
        "family": "sans",
        "weights": [
          400
        ],
        "sizePx": {
          "min": 14,
          "max": 14
        }
      },
      "control": {
        "family": "sans",
        "weights": [
          500
        ],
        "sizePx": {
          "min": 13,
          "max": 14
        }
      },
      "metric": {
        "family": "sans",
        "weights": [
          500
        ],
        "sizePx": {
          "min": 28,
          "max": 32
        },
        "fontVariantNumeric": "tabular-nums"
      },
      "metadata": {
        "family": "sans",
        "weights": [
          400
        ],
        "sizePx": {
          "min": 12,
          "max": 13
        }
      },
      "technical": {
        "family": "mono",
        "weights": [
          400,
          500
        ],
        "sizePx": {
          "min": 12,
          "max": 13
        }
      },
      "log": {
        "family": "mono",
        "weights": [
          400
        ],
        "sizePx": {
          "min": 13,
          "max": 14
        }
      }
    },
    "numericAlignment": "Apply tabular-nums to aligned or changing numbers, including Sans metrics.",
    "distribution": {
      "format": "WOFF2",
      "strategy": "Bundle fonts with the dashboard assets."
    }
  },
  "appearance": {
    "themePreferences": [
      "system",
      "light",
      "dark"
    ],
    "initialPreference": "system",
    "radiusPx": {
      "min": 6,
      "max": 8
    },
    "surfaces": "Solid backgrounds; predominantly neutral surfaces.",
    "shadows": "Restrained shadows, mainly for menus and overlays."
  },
  "usage": {
    "brand": "Copper for brand, primary actions, selection, links, and focus. Keep metrics and titles predominantly neutral.",
    "states": "Combine color with text and an icon where useful. Blue means running; green means success or health.",
    "charts": "State charts preserve semantic associations. Add colors only to distinguish separate series.",
    "borders": "Use border-subtle for structure and border-control where a border identifies a control."
  },
  "pendingDecisions": [
    "Real screen-reader verification remains an unperformed follow-up.",
    "Architecture decisions belong to issue #2."
  ],
  "sources": [
    "https://github.com/IBM/plex",
    "https://www.ibm.com/design/language/typography/typeface/",
    "https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html",
    "https://www.w3.org/WAI/WCAG22/Understanding/non-text-contrast.html",
    "https://www.w3.org/WAI/WCAG22/Understanding/use-of-color.html"
  ],
  "spacing": {
    "unit": "px",
    "scale": [
      4,
      8,
      12,
      16,
      24,
      32,
      48
    ],
    "controlPadding": [
      8,
      12
    ],
    "panelPadding": 24,
    "mobilePanelPadding": 16,
    "tableCellPadding": [
      12,
      16
    ],
    "sectionGap": 32,
    "controlMinHeight": 44
  },
  "iconography": {
    "source": "Authored SVG in docs/design/preview.js",
    "viewBox": "0 0 24 24",
    "strokeWidth": 1.75,
    "sizesPx": [
      16,
      20
    ],
    "labelsRequired": true
  },
  "localization": {
    "proposedInitialLocale": "en",
    "firstTranslation": "pt-BR",
    "previewLocale": "pt-BR",
    "timeZone": "UTC",
    "formatting": "Intl; complete ISO 8601 dates in details",
    "status": "approved"
  },
  "designArtifact": "../design/index.html",
  "interaction": {
    "forms": "Modal dialog or dedicated page only. Never inline. Filter forms follow this rule.",
    "notifications": "Persistent, dismissible toasts. Success uses status; failure uses alert. Do not move focus.",
    "validation": "Keep field errors associated with fields inside the form."
  },
  "approval": {
    "maintainer": "ojcezarferreira",
    "date": "2026-11-07",
    "scope": "Design system, screens, components, vector brand, and localization",
    "source": "Explicit approval and authorization to publish and close issue #1 in the maintainer conversation."
  }
}
