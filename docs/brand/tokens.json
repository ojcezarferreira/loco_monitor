{
  "project": "Loco Monitor",
  "referenceVersion": 1,
  "issue": "https://github.com/ojcezarferreira/loco_monitor/issues/1",
  "description": "Referência de identidade visual consolidada na conversa com o mantenedor. Os intervalos tipográficos preservam as faixas propostas; o dimensionamento final pertence à implementação dos componentes.",
  "css": {
    "scopeAttribute": "data-loco-monitor-theme",
    "prefix": "--lm-",
    "colorFormat": "sRGB hex"
  },
  "themes": {
    "light": {
      "colorScheme": "light",
      "colors": {
        "background": "#F7F7F8",
        "surface": "#FFFFFF",
        "surface-raised": "#F0F0F2",
        "border-subtle": "#DDDEE3",
        "border-control": "#818792",
        "text-primary": "#18191C",
        "text-secondary": "#626773",
        "primary": "#B54728",
        "primary-hover": "#973B21",
        "primary-foreground": "#FFFFFF",
        "primary-subtle": "#FBEDE7",
        "focus-ring": "#B54728"
      },
      "states": {
        "running": {
          "foreground": "#1D5EC9",
          "background": "#EDF4FF"
        },
        "success": {
          "foreground": "#18794E",
          "background": "#EAF7EF"
        },
        "warning": {
          "foreground": "#8C5B0A",
          "background": "#FFF6D9"
        },
        "error": {
          "foreground": "#C0343D",
          "background": "#FFF0F1"
        },
        "scheduled": {
          "foreground": "#6E49BF",
          "background": "#F3EEFF"
        },
        "neutral": {
          "foreground": "#626773",
          "background": "#F0F0F2"
        }
      }
    },
    "dark": {
      "colorScheme": "dark",
      "colors": {
        "background": "#111214",
        "surface": "#1A1C20",
        "surface-raised": "#24272C",
        "border-subtle": "#353940",
        "border-control": "#707885",
        "text-primary": "#F3F4F6",
        "text-secondary": "#A7ADB7",
        "primary": "#F08A65",
        "primary-hover": "#F5A181",
        "primary-foreground": "#21130D",
        "primary-subtle": "#38251E",
        "focus-ring": "#F08A65"
      },
      "states": {
        "running": {
          "foreground": "#81AFFF",
          "background": "#1A2940"
        },
        "success": {
          "foreground": "#65D6A2",
          "background": "#172E25"
        },
        "warning": {
          "foreground": "#E7C46A",
          "background": "#332B18"
        },
        "error": {
          "foreground": "#FF8B94",
          "background": "#391F25"
        },
        "scheduled": {
          "foreground": "#BAA0F5",
          "background": "#2B2340"
        },
        "neutral": {
          "foreground": "#A7ADB7",
          "background": "#24272C"
        }
      }
    }
  },
  "stateSemantics": {
    "running": "Executando ou informação operacional.",
    "success": "Concluído com sucesso ou condição saudável.",
    "warning": "Atenção ou retry após erro.",
    "error": "Falha ou erro.",
    "scheduled": "Agendado.",
    "neutral": "Na fila ou pausado intencionalmente.",
    "offline": "Depende do contexto: parada intencional pode ser neutra; perda inesperada de comunicação requer atenção ou erro conforme a gravidade definida pelo produto."
  },
  "typography": {
    "families": {
      "sans": {
        "name": "IBM Plex Sans",
        "cssStack": [
          "IBM Plex Sans",
          "system-ui",
          "sans-serif"
        ],
        "weights": [
          400,
          500,
          600
        ]
      },
      "mono": {
        "name": "IBM Plex Mono",
        "cssStack": [
          "IBM Plex Mono",
          "ui-monospace",
          "monospace"
        ],
        "weights": [
          400,
          500
        ]
      }
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "roles": {
      "page-title": {
        "family": "sans",
        "weights": [
          600
        ],
        "sizePx": {
          "min": 24,
          "max": 28
        }
      },
      "section-title": {
        "family": "sans",
        "weights": [
          500,
          600
        ],
        "sizePx": {
          "min": 16,
          "max": 18
        }
      },
      "body": {
        "family": "sans",
        "weights": [
          400
        ],
        "sizePx": {
          "min": 14,
          "max": 14
        }
      },
      "control": {
        "family": "sans",
        "weights": [
          500
        ],
        "sizePx": {
          "min": 13,
          "max": 14
        }
      },
      "metric": {
        "family": "sans",
        "weights": [
          500
        ],
        "sizePx": {
          "min": 28,
          "max": 32
        },
        "fontVariantNumeric": "tabular-nums"
      },
      "metadata": {
        "family": "sans",
        "weights": [
          400
        ],
        "sizePx": {
          "min": 12,
          "max": 13
        }
      },
      "technical": {
        "family": "mono",
        "weights": [
          400,
          500
        ],
        "sizePx": {
          "min": 12,
          "max": 13
        }
      },
      "log": {
        "family": "mono",
        "weights": [
          400
        ],
        "sizePx": {
          "min": 13,
          "max": 14
        }
      }
    },
    "numericAlignment": "Aplicar tabular-nums a números alinhados ou que mudam, inclusive às métricas em Sans.",
    "distribution": {
      "format": "WOFF2",
      "strategy": "Empacotar as fontes com os próprios assets do dashboard."
    }
  },
  "appearance": {
    "themePreferences": [
      "system",
      "light",
      "dark"
    ],
    "initialPreference": "system",
    "radiusPx": {
      "min": 6,
      "max": 8
    },
    "surfaces": "Fundos sólidos; maioria das áreas em neutros.",
    "shadows": "Discretas, principalmente em menus e elementos sobrepostos; valores exatos ainda pertencem à implementação."
  },
  "usage": {
    "brand": "Cobre para marca, ação principal, seleção, links e foco. Métricas e títulos permanecem predominantemente neutros.",
    "states": "Combinar cor com texto e, quando útil, ícone. Executando usa azul; sucesso ou saúde usa verde.",
    "charts": "Gráficos de estados repetem as associações semânticas; outras cores só separam séries quando necessário.",
    "borders": "Usar border-subtle para estrutura discreta e border-control para contornos necessários à identificação de controles."
  },
  "pendingDecisions": [
    "Escala de espaçamento.",
    "Biblioteca e regras de iconografia.",
    "Componentes reutilizáveis e seus estados completos.",
    "Layouts de overview de filas, lista de jobs, detalhes, filtros e feedback de operações.",
    "Estados de loading, vazio, indisponível, erro e permissão negada.",
    "Comportamento responsivo e critérios completos de interação por teclado.",
    "Idiomas, localização e formatos regionais.",
    "Revisão e aprovação dos artefatos de interface completos pelo mantenedor."
  ],
  "sources": [
    "https://github.com/IBM/plex",
    "https://www.ibm.com/design/language/typography/typeface/",
    "https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html",
    "https://www.w3.org/WAI/WCAG22/Understanding/non-text-contrast.html",
    "https://www.w3.org/WAI/WCAG22/Understanding/use-of-color.html"
  ]
}
